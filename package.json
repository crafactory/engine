{
  "name": "crafactory-engine",
  "productName": "Crafactory Engine",
  "version": "0.1.0",
  "description": "An independently implemented, local-first Markdown knowledge workspace.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Crafactory contributors",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env ENGINE_DEV=1 electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "check": "npm run test && npm run build",
    "dist": "npm run build && electron-builder",
    "licenses": "license-checker --production --json",
    "cli": "node bin/engine.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@lezer/highlight": "^1.2.1",
    "@xyflow/react": "^12.4.0",
    "chokidar": "^4.0.0",
    "d3": "^7.9.0",
    "dompurify": "^3.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/d3": "^7.4.0",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "license-checker": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.0"
  },
  "engines": {"node": ">=22.12.0"},
  "overrides": {"katex": "$katex"},
  "build": {
    "appId": "com.crafactory.engine",
    "productName": "Crafactory Engine",
    "files": ["dist/**/*", "electron/**/*", "core/**/*", "public/icon.png", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "icon": "public/icon.png",
    "directories": {"output": "release"},
    "mac": {"target": ["dmg"], "category": "public.app-category.productivity"},
    "win": {"target": ["nsis"]},
    "linux": {"target": ["AppImage", "deb"], "category": "Office", "icon": "public/icon.png"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
