{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "**/*.md",
    ".agents/**",
    "docs/**",
    "examples/**",
    "android/**",
    "public/**",
    ".compat-corpus/**",
    "dist/**",
    "release/**",
    "test-results*/**",
    "playwright-report/**",
    "coverage/**"
  ]
}
