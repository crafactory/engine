<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Acceptance-only IME; absent from release builds and disabled unless adb selects it. -->
        <service android:name=".CompositionIme" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/composition_ime" />
        </service>
        <receiver android:name=".CompositionIme$Run" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.crafactory.engine.TEST_COMPOSITION" /></intent-filter>
        </receiver>
    </application>
</manifest>
